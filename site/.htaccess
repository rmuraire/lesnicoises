DirectoryIndex index.html
# 2026-10-11 critical QA security and visitor error handling.
# Never expose directory contents; keep individual public assets accessible.
Options -Indexes
ErrorDocument 404 /404.html
RewriteEngine On

# Build/backup/data files are not public resources, even when the file URL is known.
RewriteRule ^(?:scripts|backup|data)(?:/|$) - [F,L]

# Canonical, friendly fallbacks for obsolete hub-less directories and EN aliases.
RewriteRule ^stay/?$ /en/hotels/ [R=301,L]
RewriteRule ^fr/dormir/?$ /hotels/ [R=301,L]
RewriteRule ^en/hotels/(?:eze|roquebrune-cap-martin|saint-jean-cap-ferrat)/?$ /en/hotels/ [R=301,L]
RewriteRule ^hotels/(?:eze|roquebrune-cap-martin|saint-jean-cap-ferrat)/?$ /hotels/ [R=301,L]
RewriteRule ^en/plan/?$ /plan/ [R=301,L]
RewriteRule ^en/plan/(.+)$ /plan/$1 [R=301,L]
RewriteRule ^en/privacy/?$ /privacy/ [R=301,L]
RewriteRule ^en/stay/?$ /en/hotels/ [R=301,L]
RewriteRule ^en/stay/(.+)$ /stay/$1 [R=301,L]
RewriteRule ^bons-plans/septembre-2026/?$ /bons-plans/octobre-2026/ [R=301,L]
RewriteRule ^en/good-finds/september-2026/?$ /en/good-finds/october-2026/ [R=301,L]
# Former EN alias of the Cannes explorations museum page (2026-10-12).
RewriteRule ^en/culture/musee-explorations-cannes/?$ /en/culture/world-explorations-museum-cannes/ [R=301,L]


# Preserve the language of the two former homepages during the domain move.
RewriteCond %{HTTP_HOST} ^(www\.)?lesnicoises\.com$ [NC]
RewriteRule ^$ https://www.mametas.com/fr/ [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?lesnicoises\.com$ [NC]
RewriteRule ^en/?$ https://www.mametas.com/ [R=301,L]

# Every other historical URL keeps its path on the new domain.
RewriteCond %{HTTP_HOST} ^(www\.)?lesnicoises\.com$ [NC]
RewriteRule ^(.*)$ https://www.mametas.com/$1 [R=301,L,NE]

# Use www.mametas.com as the only production hostname.
RewriteCond %{HTTP_HOST} ^mametas\.com$ [NC]
RewriteRule ^(.*)$ https://www.mametas.com/$1 [R=301,L,NE]

# The former English homepage is now the production root.
RewriteCond %{HTTP_HOST} ^www\.mametas\.com$ [NC]
RewriteRule ^en/?$ / [R=301,L]

# One canonical Nice hotel chooser per language. Individual hotel pages keep their URLs.
RewriteRule ^en/hotels/nice/?$ /stay/nice/ [R=301,L]
RewriteRule ^en/hotels/nice/index\.html$ /stay/nice/ [R=301,L]
RewriteRule ^hotels/nice/?$ /fr/dormir/nice/ [R=301,L]
RewriteRule ^hotels/nice/index\.html$ /fr/dormir/nice/ [R=301,L]


# Mametas Riviera Fit canonical route.
RewriteRule ^riviera-chooser/?$ /riviera-fit/ [R=301,L]
RewriteRule ^riviera-chooser/index\.html$ /riviera-fit/ [R=301,L]
RewriteRule ^en/riviera-chooser/?$ /en/riviera-fit/ [R=301,L]
RewriteRule ^en/riviera-chooser/index\.html$ /en/riviera-fit/ [R=301,L]


# V3 closure cache policy — public HTML/CSS/JS must revalidate.
# This prevents OVH/proxy/browser layers from serving a previous generated build
# after a successful deployment. Static images keep only a short cache while V3 closes.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|css|js)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(?:webp|avif|png|jpe?g|svg)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
